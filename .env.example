# ─── أساسيات البوت ─────────────────────────────────────────────
# توكن البوت من @BotFather
BOT_TOKEN=

# أرقام المشرفين (Telegram IDs) مفصولة بفواصل — مثال: 123456789,987654321
ADMIN_USER_IDS=

# ─── قاعدة البيانات ───────────────────────────────────────────
# مسار قاعدة البيانات (افتراضي: sqlite:///./store.db)
DATABASE_URL=sqlite:///./store.db

# ─── لوحة الإدارة (Flask) ─────────────────────────────────────
# مفتاح توقيع الجلسات — مهم جداً! قيمة عشوائية طويلة
# توليد: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# عنوان الاستماع (افتراضي 127.0.0.1 — ضعه 0.0.0.0 فقط خلف nginx على VPS)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=5000

# ─── مزود الشحن الخارجي (MHD / shams4store) ──────────────────
# مفتاح API الخاص بالمزود
MHD_API_KEY=
MHD_API_BASE_URL=https://api.shams4store.com/client/api

# تفعيل الشراء الآلي عبر مزود MHD (true/false)
MHD_API_ENABLED=false

# مزامنة الأسعار تلقائياً
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=60

# تنبيه انخفاض رصيد المزود
MHD_LOW_BALANCE_THRESHOLD=5.0
MHD_BALANCE_CHECK_ENABLED=true